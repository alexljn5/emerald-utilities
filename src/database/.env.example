# Emerald Utilities — Database Environment Configuration
# --------------------------------------------------------------------
# Copy this file to src/.env and fill in real values.
# src/.env is git-ignored and NEVER committed.
#
#   copy src/database/.env.example src/.env
#
# Precedence: these env vars OVERRIDE src/database/config.json.
# dotenv is loaded with { override: true }, so values here WIN over any
# pre-existing machine environment variables.
# --------------------------------------------------------------------

# ---- Deployment Mode ------------------------------------------------
# AI_MODE controls whether the app uses remote (homelab) or local AI.
# DATABASE_MODE controls whether the app uses remote (homelab) or local PostgreSQL.
#
# Valid values: remote | local
# Default: remote
#
# AI_MODE=remote  → use homelab AI provider (Ollama on 192.168.2.27)
# AI_MODE=local   → use legacy local AI infrastructure
#
# DATABASE_MODE=remote → connect to homelab PostgreSQL (192.168.2.27:5432)
# DATABASE_MODE=local  → start local PostgreSQL via db-start.sh
#
# These switches are independent. Examples:
#   AI_MODE=remote DATABASE_MODE=remote  (production/homelab)
#   AI_MODE=local  DATABASE_MODE=remote  (local AI, remote DB)
#   AI_MODE=remote DATABASE_MODE=local   (remote AI, local DB)
AI_MODE=remote
DATABASE_MODE=remote

# ---- PostgreSQL (remote homelab) ------------------------------------
# Only used when DATABASE_MODE=remote.
# In development against a local DB use 127.0.0.1.
# In production point at the headless server on the LAN.
DB_HOST=192.168.2.27
DB_PORT=5432
DB_NAME=emerald_utilities
DB_USER=alexljn5
DB_PASSWORD=[REDACTED]

# ---- Tasks database (uses the SAME PostgreSQL instance) -------------
# The tasks application connects to the main Emerald database via the
# shared DB_* configuration below. No separate TASKS_DATABASE_URL needed.
#
# JSON ↔ PostgreSQL sync:
#   - JSON files in userData/tasks-data/ act as a recovery mirror.
#   - On startup, sync-tasks-data.sh reconciles JSON with PostgreSQL.
#   - TASKS_JSON_DIR can override the JSON directory (for CLI/testing).

# ---- Docker Compose PostgreSQL settings -----------------------------
# These control the PostgreSQL container itself.
POSTGRES_USER=alexljn5
POSTGRES_PASSWORD=[REDACTED]
POSTGRES_DB=emerald_utilities
# Host port mapping. Use 5432 for primary, 5433 if 5432 is occupied.
POSTGRES_PORT=5432

# ---- AI provider ----------------------------------------------------
# One of: ollama | grok | openai | lmstudio
AI_PROVIDER=ollama

# ---- Ollama (local models, runs in a `screen` session, NOT Docker) --
# NOTE: The Windows Ollama installer may set a machine-level
# OLLAMA_HOST=http://localhost:11434. Because .env is loaded with
# override:true, the value here takes precedence.
OLLAMA_HOST=http://192.168.2.27:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2
# Embedding vector dimension. nomic-embed-text = 768.
OLLAMA_EMBED_DIM=768

# ---- RAG embedding batch tuning (rag-prepare.js) --------------------
# How many messages to fetch/embed per DB page. Lower = gentler on Ollama.
# RAG_EMBED_BATCH=100
# Optional per-run cap on how many messages to embed (0 / unset = all).
# Useful for incremental backfills. e.g. RAG_MAX_EMBED=2000
# RAG_MAX_EMBED=0

# ---- Cloud providers (only if AI_PROVIDER is grok/openai) -----------
# GROK_API_KEY=
# OPENAI_API_KEY=

# ---- Debugging ------------------------------------------------------
# Set to enable verbose debug logs and stack traces.
# EMERALD_DEBUG=1
# Set NO_COLOR=1 to disable ANSI colors in logs.
# NO_COLOR=1
