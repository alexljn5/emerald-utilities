# ───────────────────────────────────────────────
# Emerald Utilities — Environment Configuration
# ───────────────────────────────────────────────
# Copy this file to src/.env (development) or
# import it via Settings > Environment (production).
#
# Required variables are marked with [REQUIRED].
# Optional variables enhance functionality.
# ───────────────────────────────────────────────

# ── Instagram API with Instagram Login ──────────────────
# Developer portal: https://developers.facebook.com/
# Required permissions: instagram_business_basic,
#                       instagram_business_content_publish
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3541/instagram/callback

# ── Instagram Publishing Media Tunnel ───────────────────
# Instagram Graph API cannot fetch media from localhost.
# Leave INSTAGRAM_MEDIA_BASE_URL empty to auto-start a Cloudflare tunnel.
# Set it to a public URL if you already have one (e.g. from ngrok or your own server).
INSTAGRAM_MEDIA_BASE_URL=
CLOUDFLARE_TUNNEL_ENABLED=true
CLOUDFLARE_BINARY=cloudflared

# ── Threads API ──────────────────────────────────────
# Developer portal: https://developers.facebook.com/
# Required permissions: threads_basic, threads_content_publish
# Can reuse INSTAGRAM_APP_ID and INSTAGRAM_APP_SECRET if using the same Meta app
#
# IMPORTANT: Meta requires HTTPS for OAuth redirect URIs.
# Option A (recommended): Use emerald:// deep-link protocol
#   THREADS_REDIRECT_URI=emerald://threads-callback
# Option B: Use HTTPS localhost (requires mkcert certificates)
#   THREADS_REDIRECT_URI=https://localhost:3541/threads/callback
#   Then generate certs: mkdir -p src/oauth/certs && cd src/oauth/certs && mkcert localhost 127.0.0.1 ::1
#
# Option 1 (preferred): Set THREADS_ACCESS_TOKEN directly to skip OAuth.
#   Obtain a token from the Meta Developer Portal or via the OAuth flow once,
#   then paste it here. The app will use it for all Threads API requests.
THREADS_ACCESS_TOKEN=
#
# Option 2: OAuth flow (fallback when THREADS_ACCESS_TOKEN is not set).
#   The app will open a browser for user authorization.
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=emerald://threads-callback

# ── Bluesky (AT Protocol) ────────────────────────────
# Documentation: https://docs.bsky.app/
# App password: Settings > Privacy & Security > App Passwords
BLUESKY_USERNAME=
BLUESKY_APP_PASSWORD=

# ── X / Twitter API ──────────────────────────────────
# Developer portal: https://developer.twitter.com/
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=

# ── TikTok Content Posting API ───────────────────────
# Developer portal: https://developers.tiktok.com/
# Required permissions: video.publish, video.upload
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3541/tiktok/callback

# ── YouTube Data API ─────────────────────────────────
# Developer portal: https://console.cloud.google.com/
# Required permissions: https://www.googleapis.com/auth/youtube.upload
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3541/youtube/callback

# ── Database ─────────────────────────────────────────
# Used by AI/RAG services and Creator Hub storage.
#
# Emerald connects to PostgreSQL as a normal client — it does NOT care
# whether the host is reachable via Tailscale, LAN, localhost, or any
# other network. Tailscale is purely an OS-level networking layer.
#
# Defaults to local Docker PostgreSQL if not set.
#
# For Tailscale-bridged homelab access, use the INFHUB-Server MagicDNS
# hostname (preferred) or the direct Tailscale IP (fallback):
#     DB_HOST=infhub-server
#     DB_HOST=100.125.191.76
# For pure local development use 127.0.0.1.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=emerald
DB_PASSWORD=
DB_DATABASE=emerald_utilities

# ── Portfolio Monitor ────────────────────────────────
# Provider: EOD Historical Data (eodhd.com)
EODHD_API=

# ── Development ──────────────────────────────────────
# Vite dev server (auto-set, usually not needed)
# VITE_DEV_SERVER_URL=http://127.0.0.1:5173
