{
  "name": "emerald-utilities",
  "version": "0.0.2",
  "description": "alexljn5's Personal Utility Program.",
  "main": "src/heavensgate.js",
  "author": "alexljn5",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^37.2.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.alexljn5.emeraldutilities",
    "productName": "Emerald Utilities",
    "win": {
      "target": "nsis",
      "icon": "img/favicons/favicon.ico"
    },
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "scripts/",
        "to": "scripts/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "img/favicons/favicon.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "img/favicons/favicon.png"
    }
  }
}