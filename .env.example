# ───────────────────────────────────────────────
# Emerald Utilities — Environment Configuration
# ───────────────────────────────────────────────
# Copy this file to src/.env (development) or
# import it via Settings > Environment (production).
#
# Required variables are marked with [REQUIRED].
# Optional variables enhance functionality.
# ───────────────────────────────────────────────

# ── Instagram API with Instagram Login ──────────────────
# Developer portal: https://developers.facebook.com/
# Required permissions: instagram_business_basic,
#                       instagram_business_content_publish
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3541/instagram/callback

# ── Instagram Publishing Media Tunnel ───────────────────
# Instagram Graph API cannot fetch media from localhost.
# Leave INSTAGRAM_MEDIA_BASE_URL empty to auto-start a Cloudflare tunnel.
# Set it to a public URL if you already have one (e.g. from ngrok or your own server).
INSTAGRAM_MEDIA_BASE_URL=
CLOUDFLARE_TUNNEL_ENABLED=true
CLOUDFLARE_BINARY=cloudflared

# ── Threads API ──────────────────────────────────────
# Developer portal: https://developers.facebook.com/
# Required permissions: threads_basic, threads_content_publish
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:3541/threads/callback

# ── Bluesky (AT Protocol) ────────────────────────────
# Documentation: https://docs.bsky.app/
# App password: Settings > Privacy & Security > App Passwords
BLUESKY_USERNAME=
BLUESKY_APP_PASSWORD=

# ── X / Twitter API ──────────────────────────────────
# Developer portal: https://developer.twitter.com/
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=

# ── Database ─────────────────────────────────────────
# Used by AI/RAG services and Creator Hub storage.
# Defaults to local Docker PostgreSQL if not set.
DB_HOST=localhost
DB_PORT=5432
DB_USER=emerald
DB_PASSWORD=
DB_DATABASE=emerald_utilities

# ── Portfolio Monitor ────────────────────────────────
# Provider: EOD Historical Data (eodhd.com)
EODHD_API=

# ── Development ──────────────────────────────────────
# Vite dev server (auto-set, usually not needed)
# VITE_DEV_SERVER_URL=http://127.0.0.1:5173
