{
  "name": "emerald-utilities",
  "version": "1.0.0",
  "description": "Utility program.",
  "main": "src/heavensgate.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^37.2.5",
    "electron-builder": "^26.0.12",
    "electron-rebuild": "^3.2.9"
  },
  "build": {
    "appId": "com.alexljn5.emeraldutilities",
    "productName": "Emerald Utilities",
    "win": {
      "target": "nsis",
      "icon": "img/favicons/favicon.ico"
    },
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "scripts/",
        "to": "scripts/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "img/favicons/favicon.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "img/favicons/favicon.png"
    },
    "electronExtraArgs": [
      "--disable-webgl",
      "--disable-gpu"
    ]
  }
}