# Emerald Utilities — Tasks Database Environment Configuration
# --------------------------------------------------------------------
# This file is OBSOLETE. Tasks now uses the unified Emerald PostgreSQL
# database configured in src/database/.env.
#
# The shared database configuration (DB_HOST, DB_PORT, DB_NAME, DB_USER,
# DB_PASSWORD) in src/database/.env is used for ALL features including Tasks.
#
# This file is kept only for reference. Do not create a .env here.
# --------------------------------------------------------------------

# PostgreSQL connection (now uses src/database/.env)
# POSTGRES_USER=emerald-user
# POSTGRES_PASSWORD=[REDACTED]
# POSTGRES_DB=[REDACTED]
# POSTGRES_PORT=5432

# Remote homelab database (OBSOLETE — use DB_HOST/DB_PORT in src/database/.env)
# TASKS_DATABASE_URL=postgres://user@<ip>:5432/emerald_utilities
